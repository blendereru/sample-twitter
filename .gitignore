# Ignore Visual Studio temporary files, build results, and
# Rider-specific files

## Ignore Rider-specific files
.idea/
*.sln.iml

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Auto-generated files
*_i.c
*_p.c
*_i.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.vspscc
.builds

# Build folders (can be generated by Rider or MSBuild)
[Bb]in/
[Oo]bj/

# Rider settings
.idea/
.idea_modules/
.idea/workspace.xml
.idea/gradle.xml
.idea/tasks.xml
.idea/dictionaries
.idea/vcs.xml

# ReSharper
_ReSharper*/
*.DotSettings.user
resharper.xml

# OS-generated files
.DS_Store
*.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

.vs/
# Rider project-specific caches
.idea/
.idea_modules/
.idea/workspace.xml
.idea/task.xml
.idea/vcs.xml
.idea/dictionaries
.idea/gradle.xml

# Packages folder (NuGet)
packages/
.nuget/

# Logs
*.log

# Temporary files
*.tmp
*.bak
*.swp

# Visual Studio Code workspace
.vscode/

# Local history files (JetBrains Rider)
.idea/localHistory

# Rider and ReSharper inspections and config files
.idea/inspectionProfiles/

# Generated by the MSBuild App
*.csproj.user
*.csproj.nuget.g.targets
*.csproj.nuget.g.props

# Rider auto-saved scratch files
.scratches/

# Rider Markdown plugin caches
.idea/mdx_cache/

# Exclude Rider environment settings
.idea/workspace.xml
.idea/dictionaries
.idea/workspace.xml
*.dockerignore

# Node & Frontend
node_modules/
dist/
dist-ssr/
.vite/

# TypeScript incremental build cache
*.tsbuildinfo

# Test and Coverage results
coverage/
test-results/
playwright-report/

# Environment and local overrides
*.local
.env.local
.env.*.local

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*